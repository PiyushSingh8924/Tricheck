# Copy these NAMES into /etc/attendance.env (EC2) or Render's Environment tab. Never commit real values.
SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_hex(32))"
TEACHER_CODE=choose-a-private-phrase
HTTPS=1
TZ=Asia/Kolkata
# optional: only if you use Postgres instead of the SQLite file
# DATABASE_URL=postgresql://...

# Email for the 6-digit student codes (Gmail example: turn on 2-Step Verification, then make an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.dedicated.account@gmail.com
SMTP_PASS=the-16-letter-app-password
MAIL_FROM=TriCheck <your.dedicated.account@gmail.com>
